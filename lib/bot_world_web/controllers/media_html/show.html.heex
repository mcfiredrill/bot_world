<section class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold">{@media_item.name}</h2>
    <p class="text-sm text-zinc-500">Media type: {@media_item.media_type}</p>
  </div>

  <div :if={@media_item.aliases != []}>
    <h3 class="text-sm font-semibold text-zinc-700">Aliases</h3>
    <p>{Enum.join(@media_item.aliases, ", ")}</p>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-zinc-700">Preview</h3>
    <%= if @media_item.media_type == "video" do %>
      <video controls class="max-w-md">
        <source src={BotWorld.S3.public_url(@media_item.s3_key)} />
      </video>
    <% else %>
      <audio controls>
        <source src={BotWorld.S3.public_url(@media_item.s3_key)} />
      </audio>
    <% end %>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-zinc-700">Direct Triggers</h3>
    <p :if={@media_item.triggers == []} class="text-sm text-zinc-400">None</p>
    <ul :if={@media_item.triggers != []} class="mt-2 space-y-1">
      <li
        :for={trigger <- @media_item.triggers}
        class="flex items-center justify-between gap-4 rounded-lg border border-zinc-200 px-3 py-2"
      >
        <span class="text-sm">
          {trigger.name}
          <span class="text-xs text-zinc-500">
            ({BotWorldWeb.TriggersHTML.format_trigger_type(trigger.type)} · {BotWorldWeb.TriggersHTML.format_trigger_match(
              trigger
            )})
          </span>
        </span>
        <.link href={~p"/triggers/#{trigger}/edit"} class="text-sm text-blue-500 hover:underline">
          Edit trigger
        </.link>
      </li>
    </ul>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-zinc-700">Media Groups</h3>
    <p :if={@media_item.media_groups == []} class="text-sm text-zinc-400">None</p>
    <ul :if={@media_item.media_groups != []} class="mt-2 space-y-1">
      <%= for group <- @media_item.media_groups do %>
        <li class="rounded-lg border border-zinc-200 px-3 py-2">
          <div class="flex items-center justify-between gap-4">
            <.link href={~p"/groups/#{group}"} class="font-semibold text-blue-500 hover:underline">
              {group.name}
            </.link>
            <.link href={~p"/groups/#{group}/edit"} class="text-sm text-blue-500 hover:underline">
              Edit group
            </.link>
          </div>
          <p :if={group.triggers == []} class="mt-2 text-xs text-zinc-400">
            No triggers target this group.
          </p>
          <ul :if={group.triggers != []} class="mt-2 space-y-1">
            <li :for={trigger <- group.triggers} class="flex items-center justify-between gap-4">
              <span class="text-sm">
                {trigger.name}
                <span class="text-xs text-zinc-500">
                  ({BotWorldWeb.TriggersHTML.format_trigger_type(trigger.type)} · {BotWorldWeb.TriggersHTML.format_trigger_match(
                    trigger
                  )})
                </span>
              </span>
              <.link
                href={~p"/triggers/#{trigger}/edit"}
                class="text-sm text-blue-500 hover:underline"
              >
                Edit trigger
              </.link>
            </li>
          </ul>
        </li>
      <% end %>
    </ul>
  </div>

  <div>
    <a href={~p"/media"} class="text-blue-500 hover:underline">Back to media</a>
    ·
    <.link
      href={~p"/media/#{@media_item}"}
      method="delete"
      data-confirm={"Delete #{@media_item.name}? This removes it from all media groups."}
      class="text-red-600 hover:underline"
    >
      Delete media item
    </.link>
  </div>
</section>
