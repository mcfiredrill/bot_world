<section>
  <h2 class="text-2xl">sound effects bot world paradise</h2>
</section>

<a
  href={~p"/overlay/#{@overlay_token}"}
  target="_blank"
  rel="noopener noreferrer"
  class="text-blue-500 hover:underline"
>
  Open live overlay ↗
</a>

<%= if @twitch_credential do %>
  <p class="text-sm text-zinc-500">
    Twitch account connected (@{@twitch_credential.twitch_login}).
  </p>
<% end %>

<br />
<h2 class="text-xl">Create Media Item</h2>

<.simple_form :let={f} for={@changeset} action={~p"/media"} multipart>
  <.input field={f[:name]} label="Name" type="text" />

  <.input field={f[:aliases]} type="text" label="Aliases (comma‑separated)" />

  <.input
    field={f[:media_type]}
    type="select"
    label="Media Type"
    options={[{"Audio", "audio"}, {"Video", "video"}]}
  />

  <.input field={f[:media_file]} type="file" label="Media File" />

  <:actions>
    <.button>Save Media Item</.button>
  </:actions>
</.simple_form>

<hr class="my-6" />

<h2 class="text-xl font-bold mb-4">Uploaded Media</h2>

<div class="overflow-x-auto">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-zinc-200 text-zinc-600">
      <tr>
        <th class="px-3 py-2 font-semibold">Media Item</th>
        <th class="px-3 py-2 font-semibold">Preview</th>
        <th class="px-3 py-2 font-semibold">Type</th>
        <th class="px-3 py-2 font-semibold">Groups</th>
        <th class="px-3 py-2 font-semibold">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-100">
      <%= for media_item <- @media_items do %>
        <tr>
          <td class="px-3 py-3 font-semibold">{media_item.name}</td>
          <td class="px-3 py-3">
            <audio
              :if={media_item.media_type == "audio"}
              id={"media-preview-#{media_item.id}"}
              controls
              preload="none"
              class="h-9 w-56 max-w-full"
              aria-label={"Preview #{media_item.name}"}
            >
              <source src={BotWorld.S3.public_url(media_item.s3_key)} />
            </audio>
            <video
              :if={media_item.media_type == "video"}
              id={"media-preview-#{media_item.id}"}
              controls
              muted
              preload="metadata"
              class="aspect-video w-40 rounded bg-black object-contain"
              aria-label={"Preview #{media_item.name}"}
            >
              <source src={BotWorld.S3.public_url(media_item.s3_key)} />
            </video>
          </td>
          <td class="px-3 py-3">
            <span class="text-xs text-zinc-500">{media_item.media_type}</span>
          </td>
          <td class="px-3 py-3">
            <span :if={media_item.media_groups == []} class="text-zinc-400">None</span>
            <ul :if={media_item.media_groups != []} class="space-y-1">
              <li :for={group <- media_item.media_groups}>
                <.link
                  href={~p"/groups/#{group}"}
                  class="font-medium text-blue-500 hover:underline"
                >
                  {group.name}
                </.link>
                <ul :if={group.triggers != []} class="ml-3 text-xs text-zinc-500">
                  <li :for={trigger <- group.triggers}>
                    {trigger.name} · {trigger_type(trigger)} · {trigger_match(trigger)}
                  </li>
                </ul>
              </li>
            </ul>
          </td>
          <td class="px-3 py-3 whitespace-nowrap">
            <a
              href={BotWorld.S3.public_url(media_item.s3_key)}
              class="text-blue-500 hover:underline"
            >
              Download
            </a>
            · <a href={~p"/media/#{media_item}"} class="text-blue-500 hover:underline">Show</a>
            ·
            <.link
              href={~p"/media/#{media_item}"}
              method="delete"
              data-confirm={"Delete #{media_item.name}? This removes it from all media groups."}
              class="text-red-600 hover:underline"
            >
              Delete
            </.link>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
