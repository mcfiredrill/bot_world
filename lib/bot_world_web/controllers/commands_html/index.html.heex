<section>
  <h2 class="text-2xl">sound effects bot world paradise</h2>
</section>

<a
  href={~p"/overlay/#{@overlay_token}"}
  target="_blank"
  rel="noopener noreferrer"
  class="text-blue-500 hover:underline"
>
  Open live overlay ↗
</a>

<%= if BotWorld.Twitch.get_credential() do %>
  <p class="text-sm text-zinc-500">
    Twitch account connected (@{BotWorld.Twitch.get_credential().twitch_login}).
  </p>
<% else %>
  <a href={~p"/auth/twitch"} class="text-blue-500 hover:underline">
    Connect Twitch account
  </a>
<% end %>

<br />
<h2 class="text-xl">Create Command</h2>

<.simple_form :let={f} for={@changeset} action={~p"/commands"} multipart>
  <.input field={f[:name]} label="Name" type="text" />

  <.input field={f[:aliases]} type="text" label="Aliases (comma‑separated)" />

  <.input
    field={f[:media_type]}
    type="select"
    label="Media Type"
    options={[{"Audio", "audio"}, {"Video", "video"}]}
  />

  <.input field={f[:media_file]} type="file" label="Media File" />

  <:actions>
    <.button>Save Command</.button>
  </:actions>
</.simple_form>

<hr class="my-6" />

<h2 class="text-xl font-bold mb-4">Uploaded Commands</h2>

<div class="overflow-x-auto">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-zinc-200 text-zinc-600">
      <tr>
        <th class="px-3 py-2 font-semibold">Command</th>
        <th class="px-3 py-2 font-semibold">Media</th>
        <th class="px-3 py-2 font-semibold">Groups</th>
        <th class="px-3 py-2 font-semibold">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-100">
      <%= for command <- @commands do %>
        <tr>
          <td class="px-3 py-3 font-semibold">{command.name}</td>
          <td class="px-3 py-3">
            <span class="text-xs text-zinc-500">{command.media_type}</span>
          </td>
          <td class="px-3 py-3">
            <span :if={command.media_groups == []} class="text-zinc-400">None</span>
            <ul :if={command.media_groups != []} class="space-y-1">
              <li :for={group <- command.media_groups}>
                <.link
                  href={~p"/groups/#{group}"}
                  class="font-medium text-blue-500 hover:underline"
                >
                  {group.name}
                </.link>
                <ul :if={group.triggers != []} class="ml-3 text-xs text-zinc-500">
                  <li :for={trigger <- group.triggers}>
                    {trigger.name} · {trigger_type(trigger)} · {trigger_match(trigger)}
                  </li>
                </ul>
              </li>
            </ul>
          </td>
          <td class="px-3 py-3 whitespace-nowrap">
            <a
              href={"http://#{your_s3_host()}/#{command.s3_key}"}
              class="text-blue-500 hover:underline"
            >
              Download
            </a>
            · <a href={~p"/commands/#{command}"} class="text-blue-500 hover:underline">Show</a>
            ·
            <.link
              href={~p"/commands/#{command}"}
              method="delete"
              data-confirm={"Delete #{command.name}? This removes it from all media groups."}
              class="text-red-600 hover:underline"
            >
              Delete
            </.link>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
