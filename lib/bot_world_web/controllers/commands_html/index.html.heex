<section>
  <h2 class="text-2xl">sound effects bot world paradise</h2>
</section>
<br />
<h2 class="text-xl">Create Command</h2>

<.simple_form
  :let={f}
  for={@changeset}
  action={~p"/commands"}
  multipart
>
  <.input
    field={f[:name]}
    label="Name"
    type="text"
  />

  <.input field={f[:aliases]}    type="text" label="Aliases (comma‑separated)" />

  <.input
    field={f[:media_type]}
    type="select"
    label="Media Type"
    options={[{"Audio", "audio"}, {"Video", "video"}]}
  />

  <.input field={f[:media_file]} type="file" label="Media File" />

  <:actions>
    <.button>Save Command</.button>
  </:actions>
</.simple_form>

<hr class="my-6" />

<h2 class="text-xl font-bold mb-4">Uploaded Commands</h2>

<ul class="space-y-2">
  <%= for command <- @commands do %>
    <li>
      <strong><%= command.name %></strong>
      <span class="text-xs text-zinc-500">(<%= command.media_type %>)</span><br />
      <a href={"http://#{your_s3_host()}/#{command.s3_key}"} class="text-blue-500 hover:underline">
        Download link
      </a>
      ·
      <a href={~p"/commands/#{command}"} class="text-blue-500 hover:underline">
        Show
      </a>
    </li>
  <% end %>
</ul>
