<section class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold">!{@command.name}</h2>
    <p class="text-sm text-zinc-500">Media type: {@command.media_type}</p>
  </div>

  <div :if={@command.aliases != []}>
    <h3 class="text-sm font-semibold text-zinc-700">Aliases</h3>
    <p>{Enum.join(@command.aliases, ", ")}</p>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-zinc-700">Preview</h3>
    <%= if @command.media_type == "video" do %>
      <video controls class="max-w-md">
        <source src={BotWorld.S3.public_url(@command.s3_key)} />
      </video>
    <% else %>
      <audio controls>
        <source src={BotWorld.S3.public_url(@command.s3_key)} />
      </audio>
    <% end %>
  </div>

  <div :if={@command.triggers != []}>
    <h3 class="text-sm font-semibold text-zinc-700">Triggers</h3>
    <ul class="space-y-1">
      <%= for trigger <- @command.triggers do %>
        <li class="flex items-center justify-between gap-4 rounded-lg border border-zinc-200 px-3 py-2">
          <div>
            <strong>{trigger.name}</strong>
            <span class="text-xs text-zinc-500">
              ({BotWorldWeb.TriggersHTML.format_trigger_type(trigger.type)} · {BotWorldWeb.TriggersHTML.format_trigger_match(
                trigger
              )})
            </span>
          </div>
          <a href={~p"/triggers/#{trigger}/edit"} class="text-sm text-blue-500 hover:underline">
            Edit trigger
          </a>
        </li>
      <% end %>
    </ul>
  </div>

  <div>
    <a href={~p"/commands"} class="text-blue-500 hover:underline">Back to commands</a>
  </div>
</section>
