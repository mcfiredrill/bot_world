<div class="mx-auto max-w-sm">
  <.header class="text-center">
    Sign in to BotWorld
    <:subtitle>
      Twitch is your BotWorld account. First-time users are registered automatically.
    </:subtitle>
  </.header>

  <.link
    href={~p"/auth/twitch"}
    class="mt-8 block w-full rounded-lg bg-[#9146ff] px-4 py-3 text-center font-semibold text-white hover:bg-[#772ce8]"
  >
    Continue with Twitch <span aria-hidden="true">→</span>
  </.link>
</div>
