<.header>
  New Trigger
</.header>

<.simple_form :let={f} for={@changeset} action={~p"/triggers"}>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <.input field={f[:name]} type="text" label="Name" />

  <.input
    field={f[:type]}
    type="select"
    label="Type"
    options={Enum.map(@trigger_types, fn t -> {format_trigger_type(t), t} end)}
    prompt="Choose a trigger type"
    data-trigger-type-select=""
  />

  <div data-trigger-field="twitch_point_redeem">
    <.input
      field={f[:reward_name]}
      type="text"
      label="Reward Name"
      placeholder="e.g. Hydrate (matches any redeem if left blank)"
    />
  </div>

  <div data-trigger-field="twitch_bits">
    <.input
      field={f[:bits_amount]}
      type="number"
      label="Bits Amount"
      placeholder="e.g. 100 (matches any cheer amount if left blank)"
    />
  </div>

  <.input
    field={f[:target_type]}
    type="select"
    label="Target"
    options={[{"Media group", "media_group"}, {"Single media item", "media_item"}]}
    prompt="Choose a target type"
    data-target-type-select=""
  />

  <div data-target-field="media_group">
    <.input
      field={f[:media_group_id]}
      type="select"
      label="Media Group"
      options={Enum.map(@media_groups, fn group -> {group.name, group.id} end)}
      prompt="Choose a media group"
    />
  </div>

  <div data-target-field="media_item">
    <.input
      field={f[:media_item_id]}
      type="select"
      label="Media Item"
      options={Enum.map(@media_items, fn item -> {item.name, item.id} end)}
      prompt="Choose a media item"
    />
  </div>

  <:actions>
    <.button>Create Trigger</.button>
  </:actions>
</.simple_form>

<.link href={~p"/triggers"} class="mt-4 inline-block text-sm text-zinc-600 hover:text-zinc-900">
  ← Back to triggers
</.link>

<script>
  (() => {
    const select = document.querySelector("[data-trigger-type-select]");
    if (!select || select.dataset.bound === "true") return;
    select.dataset.bound = "true";

    const update = () => {
      document.querySelectorAll("[data-trigger-field]").forEach((el) => {
        el.style.display = el.dataset.triggerField === select.value ? "" : "none";
      });
    };

    select.addEventListener("change", update);
    update();

    const targetSelect = document.querySelector("[data-target-type-select]");
    const updateTarget = () => {
      document.querySelectorAll("[data-target-field]").forEach((el) => {
        const active = el.dataset.targetField === targetSelect.value;
        el.style.display = active ? "" : "none";
        el.querySelectorAll("select").forEach((input) => input.disabled = !active);
      });
    };
    targetSelect.addEventListener("change", updateTarget);
    updateTarget();
  })();
</script>
