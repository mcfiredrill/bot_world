<.header>
  Bits Rewards
  <:subtitle>Copy your rewards list into your Twitch About page.</:subtitle>
  <:actions>
    <.link href={~p"/triggers"} class="text-blue-500 hover:underline">Back to Triggers</.link>
  </:actions>
</.header>

<p :if={@rewards == []} class="mt-6 text-zinc-500">
  No Bits rewards configured yet. Add a Bits trigger to include it here.
</p>

<section :if={@rewards != []} class="mt-6 space-y-6">
  <ul class="list-disc space-y-2 pl-6">
    <li :for={reward <- @rewards}>
      <span class="font-semibold">
        {if is_nil(reward.bits_amount),
          do: "Other Bits amounts",
          else: "#{reward.bits_amount} Bits"}:
      </span>
      {reward.name}
    </li>
  </ul>

  <div>
    <label for="bits-rewards-text" class="block text-sm font-semibold">Text to copy</label>
    <textarea
      id="bits-rewards-text"
      readonly
      rows={max(length(@rewards), 5)}
      class="mt-2 block w-full rounded-lg border-zinc-300 font-mono text-sm"
    >{@rewards_text}</textarea>
    <.button type="button" data-copy-bits-rewards class="mt-3">Copy list</.button>
    <p id="bits-rewards-copy-status" role="status" class="mt-2 text-sm text-zinc-500"></p>
  </div>
</section>
