<.header>
  Triggers
  <:actions>
    <.link href={~p"/triggers/bits-rewards"} class="text-blue-500 hover:underline">
      Bits Rewards
    </.link>
    <.link href={~p"/triggers/new"}>
      <.button>New Trigger</.button>
    </.link>
  </:actions>
</.header>

<section class="mb-8 rounded-xl border border-zinc-200 p-4">
  <h2 class="text-lg font-semibold">Test a Bits Trigger</h2>
  <p class="mt-1 text-sm text-zinc-500">
    Simulates a Twitch cheer and plays the matching target in the open overlay.
  </p>
  <.form
    :let={f}
    for={%{}}
    as={:test_bits}
    action={~p"/triggers/test/bits"}
    class="mt-4 flex items-end gap-3"
  >
    <.input field={f[:bits]} type="number" min="0" step="1" label="Bits Amount" value="100" />
    <.button>Send Test Bits</.button>
  </.form>
</section>

<.table id="triggers" rows={@triggers}>
  <:col
    :let={trigger}
    label="Name"
    sort_href={sort_link("name", @sort, @direction)}
    sort_direction={sort_direction("name", @sort, @direction)}
  >
    {trigger.name}
  </:col>
  <:col
    :let={trigger}
    label="Type"
    sort_href={sort_link("type", @sort, @direction)}
    sort_direction={sort_direction("type", @sort, @direction)}
  >
    {format_trigger_type(trigger.type)}
  </:col>
  <:col
    :let={trigger}
    label="Matches"
    sort_href={sort_link("matches", @sort, @direction)}
    sort_direction={sort_direction("matches", @sort, @direction)}
  >
    {format_trigger_match(trigger)}
  </:col>
  <:col
    :let={trigger}
    label="Target"
    sort_href={sort_link("target", @sort, @direction)}
    sort_direction={sort_direction("target", @sort, @direction)}
  >
    <%= if trigger.media_item do %>
      Media item: {trigger.media_item.name}
    <% else %>
      Group: {trigger.media_group.name} ({length(trigger.media_group.media_items)} items)
    <% end %>
  </:col>
  <:action :let={trigger}>
    <.link href={~p"/triggers/#{trigger}"}>Show</.link>
  </:action>
  <:action :let={trigger}>
    <.link href={~p"/triggers/#{trigger}/edit"}>Edit</.link>
  </:action>
</.table>
